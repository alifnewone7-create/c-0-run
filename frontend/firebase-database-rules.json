{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && auth.token.email == 'portal-admin@coco-ai.internal'",

      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'portal-admin@coco-ai.internal')",

        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'portal-admin@coco-ai.internal')",

        "plan": {
          ".validate": "auth.token.email == 'portal-admin@coco-ai.internal' || newData.val() == 'free'"
        },

        "name": { ".validate": "newData.isString()" },
        "email": { ".validate": "newData.isString()" },
        "uid": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "usage": {
      ".read": "auth != null && auth.token.email == 'portal-admin@coco-ai.internal'",

      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'portal-admin@coco-ai.internal')",

        ".write": "auth != null && auth.token.email == 'portal-admin@coco-ai.internal'"
      }
    },

    "config": {
      ".read": "auth != null && auth.token.email == 'portal-admin@coco-ai.internal'",
      ".write": "auth != null && auth.token.email == 'portal-admin@coco-ai.internal'"
    }
  }
}
